[
  {
    "name": "theme_info",
    "theme_name": "Ankur Family Shop",
    "theme_version": "1.0.0",
    "theme_author": "Ankur Family Shop",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Brand",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo" },
      { "type": "range", "id": "logo_width", "min": 100, "max": 260, "step": 10, "unit": "px", "label": "Logo width", "default": 190 }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_background", "label": "Background", "default": "#f8f6ef" },
      { "type": "color", "id": "color_surface", "label": "Surface", "default": "#f1ede4" },
      { "type": "color", "id": "color_primary", "label": "Primary", "default": "#2f4858" },
      { "type": "color", "id": "color_ink", "label": "Text", "default": "#24313a" },
      { "type": "color", "id": "color_muted", "label": "Muted text", "default": "#68737a" },
      { "type": "color", "id": "color_accent", "label": "Accent", "default": "#c9af8b" },
      { "type": "color", "id": "color_border", "label": "Borders", "default": "#ddd7cb" }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "min": 1000, "max": 1500, "step": 20, "unit": "px", "label": "Page width", "default": 1200 }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "Instagram" },
      { "type": "url", "id": "social_facebook", "label": "Facebook" },
      { "type": "url", "id": "social_whatsapp", "label": "WhatsApp" }
    ]
  },
  {
    "name": "Navratri Edition (Seasonal)",
    "settings": [
      { "type": "checkbox", "id": "enable_navratri_mode", "label": "Enable Navratri Edition", "default": false },
      { "type": "header", "content": "Announcement Bar" },
      { "type": "text", "id": "navratri_announcement_text", "label": "Primary message", "default": "NAVRATRI SPECIAL • FESTIVE OFFERS NOW LIVE" },
      { "type": "text", "id": "navratri_announcement_subtext", "label": "Secondary message", "default": "Celebrate the season with everyday styles" },
      { "type": "text", "id": "navratri_announcement_cta", "label": "CTA text", "default": "SHOP THE EDIT →" },
      { "type": "url", "id": "navratri_announcement_link", "label": "CTA link" },
      { "type": "header", "content": "Navratri Hero" },
      { "type": "image_picker", "id": "navratri_hero_image", "label": "Desktop image" },
      { "type": "image_picker", "id": "navratri_hero_image_mobile", "label": "Mobile image" },
      { "type": "inline_richtext", "id": "navratri_hero_heading", "label": "Heading", "default": "CELEBRATE THE SEASON<br>IN YOUR STYLE" },
      { "type": "textarea", "id": "navratri_hero_subtext", "label": "Subtext", "default": "Easy, comfortable styles for festive days, family gatherings and everyday celebrations." },
      { "type": "text", "id": "navratri_hero_cta1", "label": "Primary CTA", "default": "SHOP NAVRATRI EDIT" },
      { "type": "url", "id": "navratri_hero_cta1_link", "label": "Primary CTA link" },
      { "type": "text", "id": "navratri_hero_cta2", "label": "Secondary CTA", "default": "SHOP MEN" },
      { "type": "url", "id": "navratri_hero_cta2_link", "label": "Secondary CTA link" },
      { "type": "header", "content": "Navratri Collection" },
      { "type": "collection", "id": "navratri_collection", "label": "Collection" },
      { "type": "text", "id": "navratri_collection_heading", "label": "Section heading", "default": "NAVRATRI EDIT" },
      { "type": "text", "id": "navratri_collection_subtext", "label": "Subtext", "default": "Fresh colours and easy styles for the festive season." },
      { "type": "header", "content": "Festive Color Palette" },
      { "type": "checkbox", "id": "navratri_show_colors", "label": "Show color palette section", "default": true },
      { "type": "text", "id": "navratri_colors_heading", "label": "Section heading", "default": "SHOP THE FESTIVE PALETTE" },
      { "type": "header", "content": "Promo Banner" },
      { "type": "checkbox", "id": "navratri_show_promo", "label": "Show promo banner", "default": true },
      { "type": "text", "id": "navratri_promo_heading", "label": "Heading", "default": "NAVRATRI DAYS" },
      { "type": "text", "id": "navratri_promo_subtext", "label": "Subtext", "default": "Everyday comfort, festive colour." },
      { "type": "text", "id": "navratri_promo_cta", "label": "CTA", "default": "EXPLORE THE EDIT" },
      { "type": "url", "id": "navratri_promo_link", "label": "CTA link" },
      { "type": "header", "content": "Accent Colors (optional overrides)" },
      { "type": "color", "id": "navratri_maroon", "label": "Deep Maroon", "default": "#7A263A" },
      { "type": "color", "id": "navratri_saffron", "label": "Saffron", "default": "#D9822B" },
      { "type": "color", "id": "navratri_gold", "label": "Festive Gold", "default": "#C9A15B" },
      { "type": "color", "id": "navratri_plum", "label": "Muted Plum", "default": "#69405D" }
    ]
  }
]
