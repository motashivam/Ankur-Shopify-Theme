[
  {
    "name": "theme_info",
    "theme_name": "Ankur Family Shop",
    "theme_version": "1.0.0",
    "theme_author": "Ankur Family Shop",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Brand",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo" },
      { "type": "range", "id": "logo_width", "min": 100, "max": 260, "step": 10, "unit": "px", "label": "Logo width", "default": 190 }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_background", "label": "Background", "default": "#f8f6ef" },
      { "type": "color", "id": "color_surface", "label": "Surface", "default": "#f1ede4" },
      { "type": "color", "id": "color_primary", "label": "Primary", "default": "#2f4858" },
      { "type": "color", "id": "color_ink", "label": "Text", "default": "#24313a" },
      { "type": "color", "id": "color_muted", "label": "Muted text", "default": "#68737a" },
      { "type": "color", "id": "color_accent", "label": "Accent", "default": "#c9af8b" },
      { "type": "color", "id": "color_border", "label": "Borders", "default": "#ddd7cb" }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "min": 1000, "max": 1500, "step": 20, "unit": "px", "label": "Page width", "default": 1200 }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "Instagram" },
      { "type": "url", "id": "social_facebook", "label": "Facebook" },
      { "type": "url", "id": "social_whatsapp", "label": "WhatsApp" }
    ]
  },
  {
    "name": "Store contact",
    "settings": [
      { "type": "text", "id": "contact_hem_name", "label": "Contact 1 name", "default": "Hem Mota" },
      { "type": "text", "id": "contact_hem_phone", "label": "Contact 1 phone", "default": "+91 81417 61807" },
      { "type": "text", "id": "contact_ashish_name", "label": "Contact 2 name", "default": "Ashish Mota" },
      { "type": "text", "id": "contact_ashish_phone", "label": "Contact 2 phone", "default": "+91 98794 05260" },
      { "type": "textarea", "id": "store_address", "label": "Store address", "default": "Soni Bazar Rd, near Mandvi, Swamiji Sheri, Mandvi, Gujarat 370465" },
      { "type": "text", "id": "contact_email", "label": "Contact email", "default": "motahem91@gmail.com" },
      { "type": "url", "id": "whatsapp_group_url", "label": "WhatsApp group invite URL", "info": "Group invite link, shown as Join WhatsApp Group.", "default": "https://chat.whatsapp.com/FFGOA2IcBJk9RBFAxV3Sif" },
      { "type": "url", "id": "google_maps_url", "label": "Google Maps link", "default": "https://maps.app.goo.gl/ALTLAf8Q87bmDb3dA" }
    ]
  },
  {
    "name": "Navratri Edition (Seasonal)",
    "settings": [
      { "type": "checkbox", "id": "enable_navratri_mode", "label": "Enable Navratri Edition", "info": "Shows the seasonal announcement, Navratri hero, picks, palette and nav item. Uncheck to return to the normal theme.", "default": false },
      { "type": "header", "content": "Announcement Bar" },
      { "type": "text", "id": "navratri_announcement_text", "label": "Message", "default": "NAVRATRI EDIT IS LIVE • EASY FESTIVE STYLES FOR EVERY DAY" },
      { "type": "text", "id": "navratri_announcement_subtext", "label": "Secondary message" },
      { "type": "text", "id": "navratri_announcement_cta", "label": "CTA text", "default": "SHOP THE EDIT" },
      { "type": "url", "id": "navratri_announcement_link", "label": "CTA link" },
      { "type": "header", "content": "Navratri Hero" },
      { "type": "image_picker", "id": "navratri_hero_image", "label": "Image (daily wear with festive colour)" },
      { "type": "image_picker", "id": "navratri_hero_image_mobile", "label": "Mobile image" },
      { "type": "inline_richtext", "id": "navratri_hero_heading", "label": "Heading", "default": "COLOUR FOR THE <em>SEASON.</em> COMFORT FOR EVERY DAY." },
      { "type": "textarea", "id": "navratri_hero_subtext", "label": "Subtext", "default": "Easy styles for festive evenings and everyday plans." },
      { "type": "text", "id": "navratri_hero_cta1", "label": "Primary CTA", "default": "SHOP NAVRATRI PICKS" },
      { "type": "url", "id": "navratri_hero_cta1_link", "label": "Primary CTA link" },
      { "type": "text", "id": "navratri_hero_cta2", "label": "Secondary CTA" },
      { "type": "url", "id": "navratri_hero_cta2_link", "label": "Secondary CTA link" },
      { "type": "header", "content": "Navratri Picks" },
      { "type": "collection", "id": "navratri_collection", "label": "Collection" },
      { "type": "text", "id": "navratri_collection_heading", "label": "Section heading", "default": "Festive mood. Everyday comfort." },
      { "type": "text", "id": "navratri_collection_subtext", "label": "Subtext", "default": "Easy everyday styles with a festive touch." },
      { "type": "header", "content": "Festive Palette" },
      { "type": "text", "id": "navratri_colors_heading", "label": "Section heading", "default": "COLOURS OF NAVRATRI" },
      { "type": "paragraph", "content": "Tiles are decorative colour inspiration and are not clickable." },
      { "type": "header", "content": "Accent Colors (optional overrides)" },
      { "type": "color", "id": "navratri_red", "label": "Festive Red", "default": "#8E3E45" },
      { "type": "color", "id": "navratri_saffron", "label": "Saffron", "default": "#D98A32" },
      { "type": "color", "id": "navratri_gold", "label": "Muted Gold", "default": "#C9A15B" }
    ]
  }
]
