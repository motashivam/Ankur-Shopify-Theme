<section class="newsletter">
  <div class="container newsletter-inner">
    <div>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {% if section.settings.show_success_message and section.settings.success_message != blank %}<p class="form-status success" data-newsletter-success hidden>{{ section.settings.success_message }}</p>{% endif %}
    </div>
    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" value="{{ form.email }}" required autocomplete="email" placeholder="{{ section.settings.placeholder }}" aria-label="{{ section.settings.placeholder }}">
      <button type="submit" aria-label="Subscribe">{% render 'icon', name: 'arrow-right' %}</button>
      {% if form.posted_successfully? %}<p class="form-status success">{{ section.settings.success_message }}</p>{% endif %}
      {% if form.errors %}<div class="form-status error">{{ form.errors | default_errors }}</div>{% endif %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A little something in your inbox" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in the loop." },
    { "type": "text", "id": "text", "label": "Text", "default": "New drops, easy styling ideas and things worth wearing." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Your email address" },
    { "type": "checkbox", "id": "show_success_message", "label": "Show success message", "default": true },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "You are on the list." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
