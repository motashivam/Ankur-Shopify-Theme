<section class="section container">
  <div class="section-heading"><div><span class="eyebrow">Explore Ankur</span><h1>{{ section.settings.heading }}</h1></div></div>
  <div class="category-grid">
    {% for collection in collections %}
      {% unless collection.handle == 'frontpage' %}
        <a class="category-card" href="{{ collection.url }}">
          {% if collection.featured_image %}{{ collection.featured_image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(max-width: 600px) 100vw, 33vw', alt: collection.title, loading: 'lazy' }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}
          <span class="category-overlay"><small>{{ collection.products_count }} products</small><strong>{{ collection.title }}</strong><span>Shop now {% render 'icon', name: 'arrow-right' %}</span></span>
        </a>
      {% endunless %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Shop collections" }]
}
{% endschema %}
