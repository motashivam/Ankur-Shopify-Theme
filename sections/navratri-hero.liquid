{% if settings.enable_navratri_mode %}
<section class="navratri-hero container">
  <div class="hero-copy">
    {% if settings.navratri_hero_heading != blank %}<h1>{{ settings.navratri_hero_heading }}</h1>{% endif %}
    {% if settings.navratri_hero_subtext != blank %}<p>{{ settings.navratri_hero_subtext }}</p>{% endif %}
    <div class="hero-actions">
      {% if settings.navratri_hero_cta1 != blank %}
        <a class="button button-dark" href="{{ settings.navratri_hero_cta1_link | default: routes.all_products_collection_url }}">{{ settings.navratri_hero_cta1 }} {% render 'icon', name: 'arrow-right' %}</a>
      {% endif %}
      {% if settings.navratri_hero_cta2 != blank %}
        <a class="text-button" href="{{ settings.navratri_hero_cta2_link | default: routes.all_products_collection_url }}">{{ settings.navratri_hero_cta2 }} {% render 'icon', name: 'arrow-right' %}</a>
      {% endif %}
    </div>
    <div class="hero-assurance">
      <span>{% render 'icon', name: 'check' %} Easy everyday fits</span>
      <span>{% render 'icon', name: 'check' %} Made for festive days</span>
    </div>
  </div>

  <div class="hero-visual">
    {% if settings.navratri_hero_image != blank %}
      {{ settings.navratri_hero_image | image_url: width: 1400 | image_tag: widths: '520, 760, 1000, 1400', sizes: '(max-width: 767px) 100vw, 55vw', alt: 'Navratri festive styles', loading: 'eager', fetchpriority: 'high' }}
    {% else %}
      <img src="{{ 'fallback-shirts.jpg' | asset_url }}" width="1400" height="2100" alt="Man wearing a smart everyday shirt" loading="eager" fetchpriority="high">
    {% endif %}
    <div class="hero-caption"><span>Navratri</span><span>Edit</span></div>
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Navratri Hero",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "Navratri Hero" }]
}
{% endschema %}