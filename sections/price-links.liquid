<section class="price-section container">
  <div class="price-intro">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
  </div>
  <div class="price-links">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><span>{{ block.settings.label }}</span>{% render 'icon', name: 'arrow-right' %}</a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Price links",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A good wardrobe starts with" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good value." },
    { "type": "text", "id": "text", "label": "Text", "default": "Everyday essentials at prices that make sense." }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Price link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Under Rs. 999" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Price links", "blocks": [{ "type": "link" }, { "type": "link" }, { "type": "link" }, { "type": "link" }] }]
}
{% endschema %}
