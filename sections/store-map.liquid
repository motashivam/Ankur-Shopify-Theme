<section class="section">
  <div class="store-map container">
    <div class="store-map-head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.address != blank -%}
        <p class="store-map-address">{{ section.settings.address | escape | newline_to_br }}</p>
      {%- endif -%}
    </div>
    {%- assign show_hem = false -%}
    {%- if section.settings.show_contacts and settings.contact_hem_phone != blank -%}{%- assign show_hem = true -%}{%- endif -%}
    {%- assign show_ashish = false -%}
    {%- if section.settings.show_contacts and settings.contact_ashish_phone != blank -%}{%- assign show_ashish = true -%}{%- endif -%}
    {%- assign show_ig = false -%}
    {%- if section.settings.show_instagram and settings.social_instagram != blank -%}{%- assign show_ig = true -%}{%- endif -%}
    {%- if show_hem or show_ashish or show_ig -%}
      <div class="store-map-links">
        {%- if show_hem -%}
          <a class="button button-outline" href="tel:{{ settings.contact_hem_phone | remove: ' ' }}">{%- if settings.contact_hem_name != blank -%}{{ settings.contact_hem_name }}: {% endif -%}{{ settings.contact_hem_phone }}</a>
        {%- endif -%}
        {%- if show_ashish -%}
          <a class="button button-outline" href="tel:{{ settings.contact_ashish_phone | remove: ' ' }}">{%- if settings.contact_ashish_name != blank -%}{{ settings.contact_ashish_name }}: {% endif -%}{{ settings.contact_ashish_phone }}</a>
        {%- endif -%}
        {%- if show_ig -%}
          <a class="button button-outline" href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram {% render 'icon', name: 'arrow-right' %}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.enable_map and section.settings.map_embed_url != blank -%}
      <div
        class="store-map-frame"
        style="--map-h-d: {{ section.settings.map_height_desktop }}px; --map-h-m: {{ section.settings.map_height_mobile }}px;"
      >
        <iframe
          src="{{ section.settings.map_embed_url }}"
          title="Ankur Family Shop location on Google Maps"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    {%- endif -%}
    {%- if section.settings.directions_url != blank -%}
      <a
        class="button button-dark store-map-btn"
        href="{{ section.settings.directions_url }}"
        target="_blank"
        rel="noopener"
      >{{ section.settings.button_label }} {% render 'icon', name: 'arrow-right' %}</a>
    {%- endif -%}
  </div>
</section>

<style>
  .store-map-head h2 { margin: 0; }
  .store-map-address { margin: 14px 0 0; color: #24313a; font-size: 15px; line-height: 1.7; }
  .store-map-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .store-map-frame {
    margin-top: 24px;
    height: var(--map-h-d, 430px);
    border: 1px solid #ddd7cb;
    border-radius: 6px;
    overflow: hidden;
    background: #f1ede4;
  }
  .store-map-frame iframe { width: 100%; max-width: 100%; height: 100%; border: 0; display: block; }
  .store-map-btn { margin-top: 22px; }
  @media (max-width: 600px) {
    .store-map-address { font-size: 14px; }
    .store-map-frame { height: var(--map-h-m, 320px); border-radius: 4px; margin-top: 20px; }
  }
</style>

{% schema %}
{
  "name": "Store map",
  "settings": [
    { "type": "checkbox", "id": "enable_map", "label": "Enable map", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "VISIT OUR STORE" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "Ankur Family Shop\nSoni Bazar Rd, near Mandvi, Swamiji Sheri,\nMandvi, Gujarat 370465" },
    { "type": "textarea", "id": "map_embed_url", "label": "Google Maps embed URL", "info": "Paste a Google Maps embed URL (the iframe src, not the short share link). Leave empty to hide the map.", "default": "https://www.google.com/maps?q=Ankur+Family+Shop,+Soni+Bazar+Rd,+Swamiji+Sheri,+Mandvi,+Gujarat+370465&output=embed" },
    { "type": "url", "id": "directions_url", "label": "Directions URL", "default": "https://maps.app.goo.gl/ALTLAf8Q87bmDb3dA" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "GET DIRECTIONS" },
    { "type": "checkbox", "id": "show_contacts", "label": "Show contact number buttons", "default": false },
    { "type": "checkbox", "id": "show_instagram", "label": "Show Instagram button", "default": false },
    { "type": "range", "id": "map_height_desktop", "label": "Map height on desktop", "min": 300, "max": 600, "step": 10, "unit": "px", "default": 430 },
    { "type": "range", "id": "map_height_mobile", "label": "Map height on mobile", "min": 200, "max": 450, "step": 10, "unit": "px", "default": 320 }
  ],
  "presets": [{ "name": "Store map" }]
}
{% endschema %}
