<section class="section container" id="shop-by-category-{{ section.id }}">
  <div class="section-heading">
    <div><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
    {% if section.settings.link_label != blank %}<a class="text-button" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.link_label }} {% render 'icon', name: 'arrow-right' %}</a>{% endif %}
  </div>
  <div class="category-grid">
    {% for block in section.blocks %}
      {% liquid
        assign destination = block.settings.collection.url | default: block.settings.link | default: routes.all_products_collection_url
        assign card_image = block.settings.image | default: block.settings.collection.featured_image
      %}
      <a class="category-card" href="{{ destination }}" {{ block.shopify_attributes }}>
        {% if card_image != blank %}
          {{ card_image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(max-width: 600px) 100vw, 33vw', alt: block.settings.heading, loading: 'lazy' }}
        {% else %}
          {% case forloop.index %}
            {% when 1 %}<img src="{{ 'fallback-shirts.jpg' | asset_url }}" width="1200" height="1800" alt="{{ block.settings.heading | escape }}" loading="lazy">
            {% when 2 %}<img src="{{ 'fallback-tshirts.jpg' | asset_url }}" width="1200" height="1800" alt="{{ block.settings.heading | escape }}" loading="lazy">
            {% else %}<img src="{{ 'fallback-bottomwear.jpg' | asset_url }}" width="1200" height="1500" alt="{{ block.settings.heading | escape }}" loading="lazy">
          {% endcase %}
        {% endif %}
        <span class="category-overlay"><small>{{ block.settings.note }}</small><strong>{{ block.settings.heading }}</strong><span>{{ block.settings.link_label }} {% render 'icon', name: 'arrow-right' %}</span></span>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Category cards",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your everyday uniform" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "link_label", "label": "View all label", "default": "View all" },
    { "type": "url", "id": "link", "label": "View all link" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shirts" },
        { "type": "text", "id": "note", "label": "Note", "default": "Work to weekend" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Custom link" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Category cards", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}
