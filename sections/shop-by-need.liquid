<section class="need-section container">
  <div class="section-heading"><div><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div></div>
  <div class="need-grid">
    {% for block in section.blocks %}
      <a class="need-card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 800 | image_tag: widths: '300, 500, 800', sizes: '(max-width: 600px) 50vw, 25vw', alt: block.settings.heading, loading: 'lazy' }}
        {% else %}
          {% case forloop.index %}
            {% when 1 %}<img src="{{ 'fallback-everyday.jpg' | asset_url }}" width="1200" height="1800" alt="{{ block.settings.heading | escape }}" loading="lazy">
            {% when 2 %}<img src="{{ 'fallback-shirts.jpg' | asset_url }}" width="1200" height="1800" alt="{{ block.settings.heading | escape }}" loading="lazy">
            {% when 3 %}<img src="{{ 'fallback-tshirts.jpg' | asset_url }}" width="1200" height="1800" alt="{{ block.settings.heading | escape }}" loading="lazy">
            {% else %}<img src="{{ 'fallback-travel.jpg' | asset_url }}" width="1200" height="1800" alt="{{ block.settings.heading | escape }}" loading="lazy">
          {% endcase %}
        {% endif %}
        <div><span>{{ block.settings.detail }}</span><strong>{{ block.settings.heading }}</strong>{% render 'icon', name: 'arrow-right' %}</div>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Shop by need",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Whatever the day calls for" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by need" }
  ],
  "blocks": [
    {
      "type": "need",
      "name": "Need",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Everyday" },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Reliable staples for every day" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Shop by need", "blocks": [{ "type": "need" }, { "type": "need" }, { "type": "need" }, { "type": "need" }] }]
}
{% endschema %}
