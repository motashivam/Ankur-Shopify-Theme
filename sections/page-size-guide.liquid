<section class="section">
  <div class="page-size container">
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.intro != blank -%}
      <div class="page-size-intro">{{ section.settings.intro }}</div>
    {%- endif -%}
    {%- if section.blocks.size == 0 -%}
      {%- if request.design_mode -%}
        <p class="page-size-empty">Add size rows from the Theme Editor.</p>
      {%- endif -%}
    {%- else -%}
    <div class="page-size-tablewrap">
      <table class="page-size-table">
        <thead>
          <tr><th scope="col">Size</th><th scope="col">Chest ({{ section.settings.unit }})</th><th scope="col">Waist ({{ section.settings.unit }})</th><th scope="col">Length ({{ section.settings.unit }})</th></tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- if block.settings.size == blank and block.settings.chest == blank and block.settings.waist == blank and block.settings.length == blank -%}{%- continue -%}{%- endif -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.size }}</th>
              <td>{{ block.settings.chest }}</td>
              <td>{{ block.settings.waist }}</td>
              <td>{{ block.settings.length }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- endif -%}
    {%- if section.settings.note != blank -%}
      <div class="page-size-note">{{ section.settings.note }}</div>
    {%- endif -%}
  </div>
</section>

<style>
  .page-size { max-width: 820px; }
  .page-size h1 { margin: 0 0 14px; }
  .page-size-intro { margin: 0 0 24px; color: #24313a; font-size: 15px; line-height: 1.7; }
  .page-size-intro p { margin: 0 0 10px; }
  .page-size-tablewrap { overflow-x: auto; border: 1px solid #ddd7cb; border-radius: 6px; background: #fff; }
  .page-size-table { width: 100%; min-width: 480px; border-collapse: collapse; font-size: 14px; color: #24313a; }
  .page-size-table th, .page-size-table td { padding: 13px 16px; text-align: left; border-bottom: 1px solid #ddd7cb; }
  .page-size-table tbody tr:last-child th, .page-size-table tbody tr:last-child td { border-bottom: 0; }
  .page-size-table thead th { background: #f1ede4; font-size: 12px; letter-spacing: .05em; text-transform: uppercase; color: #2f4858; }
  .page-size-table tbody th { font-weight: 600; }
  .page-size-note { margin: 18px 0 0; color: #68737a; font-size: 14px; line-height: 1.7; }
  .page-size-note p { margin: 0 0 10px; }
  .page-size-empty { margin: 0; padding: 18px; border: 1px dashed #c9af8b; border-radius: 4px; color: #68737a; font-size: 14px; }
  @media (max-width: 600px) {
    .page-size-table th, .page-size-table td { padding: 11px 12px; font-size: 13px; }
  }
</style>

{% schema %}
{
  "name": "Size guide",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "SIZE GUIDE" },
    { "type": "select", "id": "unit", "label": "Measurement unit", "options": [{ "value": "in", "label": "Inches" }, { "value": "cm", "label": "Centimeters" }], "default": "in" },
    { "type": "richtext", "id": "intro", "label": "Intro text" },
    { "type": "richtext", "id": "note", "label": "Note", "default": "<p>Fit can vary by style. When in doubt, visit the store or call us and we will help you pick the right size.</p>" }
  ],
  "blocks": [
    {
      "type": "size_row",
      "name": "Size row",
      "settings": [
        { "type": "text", "id": "size", "label": "Size" },
        { "type": "text", "id": "chest", "label": "Chest" },
        { "type": "text", "id": "waist", "label": "Waist" },
        { "type": "text", "id": "length", "label": "Length" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "Size guide" }]
}
{% endschema %}
