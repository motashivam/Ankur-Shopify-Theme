<section class="section">
  <div class="page-about container">
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.subtext != blank -%}
      <p class="page-about-sub">{{ section.settings.subtext }}</p>
    {%- endif -%}
    {%- if section.settings.image != blank -%}
      <figure class="page-about-media">
        {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '640, 960, 1280, 1600', sizes: '(max-width: 600px) calc(100vw - 32px), 780px', alt: section.settings.image.alt | default: section.settings.heading, loading: 'lazy' }}
      </figure>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <div class="page-about-copy">{{ section.settings.intro }}</div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="page-about-points">
        {%- for block in section.blocks -%}
          {%- if block.settings.heading == blank and block.settings.text == blank -%}{%- continue -%}{%- endif -%}
          <div {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    <div class="page-about-store">
      <h2>{{ section.settings.store_heading }}</h2>
      {%- if settings.store_address != blank -%}
        <p class="page-about-address">{{ settings.store_address | escape | newline_to_br }}</p>
      {%- endif -%}
      <div class="page-about-ctas">
        {%- if settings.google_maps_url != blank -%}
          <a class="button button-dark" href="{{ settings.google_maps_url }}" target="_blank" rel="noopener">{{ section.settings.directions_label }}</a>
        {%- endif -%}
        <a class="button button-outline" href="/pages/contact">{{ section.settings.contact_label }}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .page-about { max-width: 780px; }
  .page-about h1 { margin: 0 0 12px; }
  .page-about-sub { margin: 0 0 26px; color: #68737a; font-size: 15px; line-height: 1.7; }
  .page-about-media { margin: 0 0 26px; }
  .page-about-media img { width: 100%; height: auto; display: block; border: 1px solid #ddd7cb; border-radius: 4px; }
  .page-about-copy p { margin: 0 0 16px; color: #24313a; font-size: 15px; line-height: 1.8; }
  .page-about-copy p:last-child { margin-bottom: 0; }
  .page-about-copy a { color: #2f4858; }
  .page-about-points { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 30px; }
  .page-about-points h3 { margin: 0 0 8px; font-size: 13px; letter-spacing: .06em; color: #2f4858; }
  .page-about-points p { margin: 0; font-size: 14px; line-height: 1.7; color: #24313a; }
  .page-about-store { margin-top: 34px; padding-top: 26px; border-top: 2px solid #c9af8b; }
  .page-about-store h2 { margin: 0 0 12px; font-size: 22px; }
  .page-about-address { margin: 0; color: #24313a; font-size: 15px; line-height: 1.7; }
  .page-about-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  @media (max-width: 600px) {
    .page-about-sub, .page-about-copy p, .page-about-address { font-size: 14px; }
    .page-about-points { grid-template-columns: 1fr; gap: 16px; }
    .page-about-ctas .button { flex: 1 1 100%; }
  }
</style>

{% schema %}
{
  "name": "About",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "ABOUT ANKUR" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Simple, comfortable clothing for everyday life." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Ankur Family Shop is a clothing store in Mandvi focused on practical, comfortable everyday fashion. Our aim is to make it easier for customers to find reliable styles for work, weekends and regular wear.</p>" },
    { "type": "text", "id": "store_heading", "label": "Store heading", "default": "VISIT OUR STORE" },
    { "type": "text", "id": "directions_label", "label": "Directions button", "default": "GET DIRECTIONS" },
    { "type": "text", "id": "contact_label", "label": "Contact button", "default": "CONTACT US" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "About" }]
}
{% endschema %}
