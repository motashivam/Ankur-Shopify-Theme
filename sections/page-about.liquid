<section class="section">
  <div class="page-about container">
    <h1>{{ section.settings.heading }}</h1>
    <div class="page-about-copy">{{ section.settings.text }}</div>
  </div>
</section>

<style>
  .page-about { max-width: 780px; }
  .page-about h1 { margin: 0 0 18px; }
  .page-about-copy p { margin: 0 0 16px; color: #24313a; font-size: 15px; line-height: 1.8; }
  .page-about-copy p:last-child { margin-bottom: 0; }
  .page-about-copy a { color: #2f4858; }
  @media (max-width: 600px) {
    .page-about-copy p { font-size: 14px; }
  }
</style>

{% schema %}
{
  "name": "About",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "ABOUT ANKUR" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Ankur Family Shop is a clothing store in Mandvi focused on simple, comfortable everyday fashion for work, weekends and regular wear.</p>" }
  ],
  "presets": [{ "name": "About" }]
}
{% endschema %}
