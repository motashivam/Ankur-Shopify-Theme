{%- if settings.enable_navratri_mode and section.settings.image != blank -%}
<section class="navratri-banner">
  <picture class="navratri-banner-media" aria-hidden="true">
    {%- if section.settings.mobile_image != blank -%}
      <source media="(max-width: 600px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">
    {%- endif -%}
    {{ section.settings.image | image_url: width: 2000 | image_tag: widths: '900, 1400, 2000', sizes: '100vw', alt: '', loading: 'lazy' }}
  </picture>
  <div class="container navratri-banner-copy">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading | newline_to_br }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a class="button button-light" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }} {% render 'icon', name: 'arrow-right' %}</a>
    {%- endif -%}
  </div>
</section>

<style>
  .navratri-banner { position: relative; display: flex; align-items: center; min-height: 420px; overflow: hidden; background: #263B50; }
  .navratri-banner-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .navratri-banner-media::after { content: ''; position: absolute; inset: 0; background: rgba(38, 59, 80, 0.62); }
  .navratri-banner-copy { position: relative; padding-top: 72px; padding-bottom: 72px; max-width: 640px; margin-inline: 0; color: #F8F6EF; }
  .navratri-banner .eyebrow { color: #C9A15B; }
  .navratri-banner h2 { color: #F8F6EF; margin-top: 12px; }
  .navratri-banner p { margin-top: 16px; line-height: 1.7; font-size: 15px; }
  .navratri-banner .button { margin-top: 26px; }
  @media (max-width: 600px) {
    .navratri-banner { min-height: 360px; }
    .navratri-banner-copy { padding-top: 56px; padding-bottom: 56px; }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Navratri banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Navratri Edit" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Nine nights. Easy style." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Comfortable looks made for festive evenings and everyday plans." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop festive styles" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Navratri banner" }]
}
{% endschema %}
