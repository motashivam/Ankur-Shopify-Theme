<section class="section">
  <div class="page-faq container">
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.subtext != blank -%}
      <p class="page-faq-sub">{{ section.settings.subtext }}</p>
    {%- endif -%}
    <div class="page-faq-list">
      {%- for block in section.blocks -%}
        {%- if block.settings.question == blank -%}{%- continue -%}{%- endif -%}
        <details {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.question }}</span>{% render 'icon', name: 'chevron-down' %}</summary>
          <div class="page-faq-answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .page-faq { max-width: 820px; }
  .page-faq h1 { margin: 0 0 14px; }
  .page-faq-sub { margin: 0 0 26px; color: #68737a; font-size: 15px; line-height: 1.7; }
  .page-faq-list details { border-bottom: 1px solid #ddd7cb; }
  .page-faq-list details:first-child { border-top: 1px solid #ddd7cb; }
  .page-faq-list summary {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    min-height: 44px; padding: 14px 0; margin: 0; cursor: pointer;
    font-size: 15px; font-weight: 600; color: #24313a; list-style: none;
  }
  .page-faq-list summary::-webkit-details-marker { display: none; }
  .page-faq-list summary .icon { width: 18px; height: 18px; flex: 0 0 auto; color: #2f4858; transition: transform .2s; }
  .page-faq-list details[open] summary .icon { transform: rotate(180deg); }
  .page-faq-answer { padding: 0 0 18px; color: #24313a; font-size: 15px; line-height: 1.7; }
  .page-faq-answer p { margin: 0 0 10px; }
  .page-faq-answer p:last-child { margin-bottom: 0; }
  .page-faq-answer a { color: #2f4858; }
  @media (max-width: 600px) {
    .page-faq-list summary, .page-faq-answer { font-size: 14px; }
  }
</style>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQ" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Quick answers. For anything else, call the store or send us a message." }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
