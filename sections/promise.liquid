<section class="promo container">
  <div class="promo-copy">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    {% if section.settings.button_label != blank %}<a class="button button-light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} {% render 'icon', name: 'arrow-right' %}</a>{% endif %}
  </div>
  <div class="promo-details">
    {% for block in section.blocks %}
      <div {{ block.shopify_attributes }}>
        {% render 'icon', name: block.settings.icon %}
        <strong>{{ block.settings.heading }}</strong><span>{{ block.settings.text }}</span>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Brand promise",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Ankur promise" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Clothes that keep <em>up with real life.</em>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "From the first chai to the last plan of the day, find dependable fits that feel as good as they look." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Meet your new favourites" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [{ "value": "truck", "label": "Truck" }, { "value": "sparkles", "label": "Sparkles" }, { "value": "check", "label": "Check" }] },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Easy on you" },
        { "type": "text", "id": "text", "label": "Text", "default": "Comfort-first fabrics" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Brand promise", "blocks": [{ "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }] }]
}
{% endschema %}
