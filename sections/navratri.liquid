{%- if settings.enable_navratri_mode -%}
{% liquid
  assign nav_collection = section.settings.collection
  if nav_collection == blank
    assign nav_collection = collections.all
  endif
%}

<section class="section navratri">
  <div class="container">
    <div class="navratri-top">
      <div class="navratri-copy">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading | newline_to_br }}</h2>
        <h3 class="navratri-palette-heading">{{ section.settings.palette_heading }}</h3>
        <ul class="navratri-palette" aria-label="Festive palette">
          <li><span class="navratri-swatch" style="background-color: #6E2A35;"></span>Maroon</li>
          <li><span class="navratri-swatch" style="background-color: #D9A441;"></span>Mustard</li>
          <li><span class="navratri-swatch" style="background-color: #263A55;"></span>Navy</li>
          <li><span class="navratri-swatch" style="background-color: #73744A;"></span>Olive</li>
          <li><span class="navratri-swatch" style="background-color: #EFE7D6;"></span>Ivory</li>
        </ul>
      </div>
      {%- if section.settings.image != blank -%}
        <div class="navratri-visual">
          {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '520, 760, 1000, 1200', sizes: '(max-width: 850px) 100vw, 50vw', alt: section.settings.image.alt | default: section.settings.heading, loading: 'lazy' }}
        </div>
      {%- endif -%}
    </div>

    <div class="navratri-picks">
      <span class="eyebrow">{{ section.settings.picks_eyebrow }}</span>
      <h2>{{ section.settings.picks_heading }}</h2>
      {%- if section.settings.picks_subtext != blank -%}
        <p class="navratri-subtext">{{ section.settings.picks_subtext }}</p>
      {%- endif -%}
      {%- if nav_collection.products.size > 0 -%}
        <div class="product-grid">
          {% for product in nav_collection.products limit: section.settings.products_to_show %}
            {% render 'product-card', product: product %}
          {% endfor %}
        </div>
        <div class="center-action"><a class="text-button" href="{{ nav_collection.url }}">Shop the collection {% render 'icon', name: 'arrow-right' %}</a></div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .navratri.section { padding-top: 64px; padding-bottom: 64px; }
  .navratri .eyebrow { color: #8E3E45; }
  .navratri-top { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .navratri-copy h2 { margin-top: 12px; }
  .navratri-palette-heading { margin: 28px 0 0; font-size: 20px; font-weight: 600; color: #2F4858; }
  .navratri-visual img { width: 100%; height: auto; display: block; border: 1px solid #ddd7cb; border-radius: 6px; }
  .navratri-palette { display: flex; flex-wrap: wrap; gap: 18px; margin: 26px 0 0; padding: 0; list-style: none; }
  .navratri-palette li { display: grid; gap: 8px; justify-items: center; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: #68737a; }
  .navratri-swatch { width: 44px; height: 44px; border-radius: 50%; border: 1px solid #C9A15B; display: block; }
  .navratri-picks { margin-top: 56px; }
  .navratri-picks h2 { margin-top: 12px; }
  .navratri-subtext { margin-top: 14px; color: #68737a; font-size: 15px; line-height: 1.7; max-width: 560px; }
  .navratri-picks .product-grid { margin-top: 28px; }
  @media (max-width: 850px) {
    .navratri.section { padding-top: 48px; padding-bottom: 48px; }
    .navratri-top { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 600px) {
    .navratri-palette-heading { font-size: 18px; }
    .navratri-palette { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 6px; }
    .navratri-palette li { flex: 0 0 auto; }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Navratri",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Navratri Edit" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Colour for the season.\nComfort for every day." },
    { "type": "text", "id": "palette_heading", "label": "Palette heading", "default": "COLOURS OF NAVRATRI" },
    { "type": "image_picker", "id": "image", "label": "Navratri visual", "info": "Everyday menswear styling. Use a separate image, not the homepage hero image." },
    { "type": "text", "id": "picks_eyebrow", "label": "Picks eyebrow", "default": "Navratri Picks" },
    { "type": "text", "id": "picks_heading", "label": "Picks heading", "default": "Festive mood. Everyday comfort." },
    { "type": "textarea", "id": "picks_subtext", "label": "Picks subtext", "default": "Easy everyday styles with a festive touch." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 4, "label": "Products to show", "default": 8 }
  ],
  "presets": [{ "name": "Navratri" }]
}
{% endschema %}
